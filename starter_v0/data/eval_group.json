          }
        ]
      },
      "metadata": {
        "skill": "multiturn_intent_switch",
        "difficulty": "hard",
        "what_it_tests": "Chuyển đổi ý định từ tra cứu trạng thái sang tìm tài liệu hướng dẫn ở lượt sau."
      }
    },
    {
      "id": "G08_ticket_priority_change_reconfirm",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tạo ticket sự cố Outlook trên LT-204 mức low."
