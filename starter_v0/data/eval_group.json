      "phase": "B",
      "suite": "group",
      "query": "Tìm bài viết hướng dẫn cài đặt driver máy in cho máy tính mới.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "printing"
            }
          }
        ]
